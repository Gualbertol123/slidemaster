{
  "name": "@slide-builder/app",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "description": "Slide Builder browser app. `npm run build` writes ../backend/slide_builder.html (one self-contained file).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "parity": "node ../tools/parity.mjs",
    "bench": "vitest run --project react --silent=false tests/renders.test.tsx"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
