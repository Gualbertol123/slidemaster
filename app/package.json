{
  "name": "@slide-builder/app",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "description": "Slide Builder browser app. `npm run build` writes ../backend/slide_builder.html (one self-contained file).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "parity": "node ../tools/parity.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
