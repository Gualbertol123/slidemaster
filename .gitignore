# Generated at runtime (see README §2)
export/
# …but not the core's export module (run names and values, M8)
!core/src/export/
engine/
backend/slide_builder_settings.txt
backend/slide_builder_settings.txt.unreadable-*

# User workbooks
*.xlsx
*.xlsm
*.xlsb
*.xls
~$*
# …except the generated test workbooks
!app/tests/fixtures/*.xlsx
!tests/corpus/workbooks/*.xlsx
!tests/corpus/workbooks/*.xlsm
# the .xlsb twins of the corpus and Excel's own .xlsx of each (tools/make-xlsb-twins.ps1)
!tests/corpus/workbooks/xlsb/*.xlsb
!tests/corpus/workbooks/xlsb/*.xlsx
!tests/corpus/workbooks/xlsb/*.xlsm
# the recalculation corpus (spikes/recalc/make_linked.ps1, docs/next/07 §1.2): linked workbooks, Excel's recalculated
# copies per scenario value, and their .xlsb twins
!tests/corpus/workbooks/recalc/**/*.xlsx
!tests/corpus/workbooks/recalc/**/*.xlsb
# G4's stand-in (spikes/recalc/make_g4.ps1): two macro-enabled workbooks and Excel's recalculated copies
!tests/corpus/workbooks/g4/**/*.xlsm
# the large stand-in (spikes/recalc/make_large.ps1): three linked workbooks, a speed workbook, Excel's copies
!tests/corpus/workbooks/large/**/*.xlsx

__pycache__/
*.pyc

# Saved setups stay out of the repository, so updating from GitHub never touches them
backend/data/
backend/logo*.*
backend/slide_builder_settings*.txt
/slidemaster/
*.update-tmp

# spikes: generated outputs
spikes/**/out-*.pdf
spikes/**/node_modules/
spikes/parser/package-lock.json
dist/

# side-by-side program versions on a share (tools/update.py --release): app\<ver>\ (also <ver>.part,
# <ver>.old-*) and app\current.json. app/ itself holds the browser app's sources (npm workspace).
/app/[0-9]*
/app/current.json

# npm workspaces (app/, core/) install at the root
node_modules/

# parity: the HTML report, and the 30 MB workbook (python tools/make_corpus.py big30)
tests/parity/report/
tests/parity/report-dl/
tests/corpus/workbooks/big30.xlsx
bench-results.json
bench-calibration.json
review/G1/img/
review/G1/pdf/*.pdf
review/S4.4/img/
review/S4.4/index.html
review/S4.4/differences.json
review/S7b.3/img/
review/S7b.3/index.html
review/S7b.3/concepts/*.png
review/S9.2/img/
review/S9.2/index.html
review/S9.5/img/
review/S9.5/index.html
