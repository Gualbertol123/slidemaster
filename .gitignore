# Generated at runtime (see README §2)
export/
engine/
backend/slide_builder_settings.txt
backend/slide_builder_settings.txt.unreadable-*

# User workbooks
*.xlsx
*.xlsm
*.xlsb
*.xls
~$*
# …except the generated test workbooks
!app/tests/fixtures/*.xlsx
!tests/corpus/workbooks/*.xlsx
!tests/corpus/workbooks/*.xlsm

__pycache__/
*.pyc

# Saved setups stay out of the repository, so updating from GitHub never touches them
backend/data/
backend/logo*.*
backend/slide_builder_settings*.txt
/slidemaster/
*.update-tmp

# spikes: generated outputs
spikes/**/out-*.pdf
spikes/**/node_modules/
spikes/parser/package-lock.json
dist/

# side-by-side program versions on a share (tools/update.py --release): app\<ver>\ (also <ver>.part,
# <ver>.old-*) and app\current.json. app/ itself holds the browser app's sources (npm workspace).
/app/[0-9]*
/app/current.json

# npm workspaces (app/, core/) install at the root
node_modules/

# parity: the HTML report, and the 30 MB workbook (python tools/make_corpus.py big30)
tests/parity/report/
tests/corpus/workbooks/big30.xlsx
