{
  "name": "@slide-builder/core",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "The Slide Builder core: pure TypeScript with no DOM (it runs in workers from M2 of docs/next/PLAN.md). Hosts install what it needs from them through src/platform.ts.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tests",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tests && vitest run",
    "test": "vitest run",
    "bench": "vitest run --config vitest.bench.config.ts --silent=false"
  },
  "devDependencies": {
    "@ironcalc/wasm": "0.9.0",
    "@types/node": "^22.20.5",
    "harfbuzzjs": "0.4.12",
    "jsdom": "30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fflate": "0.8.2"
  }
}
