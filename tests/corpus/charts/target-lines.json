{
 "workbook": "charts/target-lines.xlsx",
 "ops": [
  {
   "op": "preset.set",
   "preset": {
    "sheets": [
     "Weekly",
     "Targets"
    ],
    "tables": [],
    "slides": [
     {
      "id": "t0",
      "type": "content",
      "title": "Weekly evolution against the budget",
      "tables": []
     },
     {
      "id": "t1",
      "type": "content",
      "title": "Reference lines beside a right axis",
      "tables": []
     }
    ]
   }
  },
  {
   "op": "item.patch",
   "slide": "t0",
   "id": "tl",
   "patch": {
    "kind": "chart",
    "type": "line",
    "title": "Loans volume - weekly evolution vs targets",
    "values": {
     "sheet": "Weekly",
     "range": "C5:F5"
    },
    "labels": {
     "sheet": "Weekly",
     "range": "C4:F4"
    },
    "legendAt": "none",
    "axes": {
     "y": {
      "min": 11300,
      "max": 12100,
      "step": 100,
      "num": "#,##0"
     },
     "x": {
      "fmt": {
       "b": true
      }
     }
    },
    "sers": {
     "vol": {
      "n": 1,
      "name": "Loans",
      "vals": [
       {
        "sheet": "Weekly",
        "range": "C5:F5"
       }
      ],
      "color": "#2F55F4",
      "line": {
       "w": 3
      },
      "marker": {
       "shape": "circle",
       "size": 9
      },
      "labels": {
       "show": [
        "value"
       ],
       "pos": "above",
       "fmt": {
        "b": true
       }
      }
     }
    },
    "marks": {
     "r1": {
      "kind": "ref",
      "value": {
       "sheet": "Targets",
       "range": "B3"
      },
      "name": {
       "sheet": "Targets",
       "range": "B2"
      }
     },
     "r2": {
      "kind": "ref",
      "value": {
       "sheet": "Targets",
       "range": "C3"
      },
      "name": {
       "sheet": "Targets",
       "range": "C2"
      }
     },
     "wc": {
      "kind": "change",
      "a": {
       "s": "vol",
       "i": -1
      },
      "caption": "Week-on-week change"
     },
     "xg": {
      "kind": "gap",
      "a": {
       "s": "vol",
       "i": -1
      },
      "ref": "r1",
      "caption": "gap to budget"
     }
    },
    "box": {
     "x": 120,
     "y": 180,
     "w": 1360,
     "h": 640
    }
   }
  },
  {
   "op": "item.patch",
   "slide": "t1",
   "id": "tc",
   "patch": {
    "kind": "chart",
    "type": "combo",
    "title": "Combo - lines on the left axis beside a right axis",
    "values": {
     "sheet": "Weekly",
     "range": "C5:F5"
    },
    "labels": {
     "sheet": "Weekly",
     "range": "C4:F4"
    },
    "legendAt": "bottom",
    "axes": {
     "y": {
      "min": 11000,
      "max": 12200,
      "num": "#,##0"
     }
    },
    "sers": {
     "vol": {
      "n": 1,
      "name": "Loans",
      "type": "line",
      "vals": [
       {
        "sheet": "Weekly",
        "range": "C5:F5"
       }
      ],
      "marker": {
       "shape": "square",
       "size": 8
      }
     },
     "cnt": {
      "n": 2,
      "name": "Budget (bars)",
      "type": "column",
      "axis": "y2",
      "vals": [
       {
        "sheet": "Targets",
        "range": "B3"
       },
       {
        "sheet": "Targets",
        "range": "C3"
       },
       {
        "sheet": "Targets",
        "range": "B3"
       },
       {
        "sheet": "Targets",
        "range": "C3"
       }
      ]
     }
    },
    "marks": {
     "r1": {
      "kind": "ref",
      "value": 11500,
      "name": "Floor (typed)",
      "pos": "above",
      "show": "both",
      "style": {
       "dash": "dotted",
       "color": "#7F7F7F",
       "w": 2
      }
     },
     "r2": {
      "kind": "ref",
      "value": {
       "sheet": "Targets",
       "range": "B3"
      },
      "name": "Budget",
      "pos": "left",
      "show": "name"
     },
     "p1": {
      "kind": "change",
      "a": {
       "s": "vol",
       "i": -1
      },
      "pos": "line",
      "pairs": "last",
      "abs": true,
      "pct": false,
      "signs": {
       "pos": "#0B6E4F",
       "neg": "#B00020"
      }
     },
     "g1": {
      "kind": "gap",
      "a": {
       "s": "vol",
       "i": -1
      },
      "ref": "r2",
      "pos": "left",
      "pct": true,
      "caption": "",
      "signs": "fixed",
      "style": {
       "color": "#1F3864",
       "heads": {
        "a": "triangle",
        "b": "triangle"
       }
      }
     },
     "zz": {
      "kind": "ref",
      "value": {
       "sheet": "Targets",
       "range": "C3"
      },
      "name": "Off (kept)",
      "off": true
     }
    },
    "box": {
     "x": 120,
     "y": 180,
     "w": 1360,
     "h": 640
    }
   }
  }
 ]
}
